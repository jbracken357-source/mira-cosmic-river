    "paths": { "/node_modules/.vite/deps/@react-three_fiber.js": ["./tests/e2e/react-three-fiber-roots.d.ts"] },
    "types": ["node", "vite/client"]
  },
  "include": ["tests", "playwright.config.ts"]
}
